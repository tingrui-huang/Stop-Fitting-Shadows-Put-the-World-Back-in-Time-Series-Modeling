#!/bin/bash
# S1_QO_ONLY (question + options, nothing else) for Qwen3.5-9B.
#
# The Sonnet-5 run of this ablation lives in results/sanity/s1_qo_only_raw/ and
# was made through the Claude CLI, which does not expose decoding parameters -
# that run is explicitly not temperature 0.  This one uses the same decoding as
# the Qwen3.5-9B C0-C3 runs (temperature 0.0, top_p 1.0, seed 20260823,
# ceiling 22000) so it is comparable with them, not with the Sonnet sanity run.
#
# The prompts are regenerated by sanity/build_sanity_conditions.py and exported
# by sanity/export_sanity_cli.py; both were verified byte-identical to what the
# Sonnet run saw (sanity_conditions_manifest.json unchanged under git).
#
# Results land in results/qwen35_9b/s1_qo_only_raw/, disjoint from both the
# C0-C3 tree and the Sonnet sanity tree.
#
#SBATCH --job-name=qwen35_s1
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus-per-node=1
#SBATCH --time=04:00:00
#SBATCH --output=slurm_logs/qwen35_s1_%j.out
#SBATCH --error=slurm_logs/qwen35_s1_%j.err

set -euo pipefail

MODEL="Qwen/Qwen3.5-9B"
RUN_TAG="qwen35_9b"
COND="S1_QO_ONLY"
PORT=8400

source ~/miniforge3/etc/profile.d/conda.sh
conda activate qwen_vllm312
module load 2025
module load CUDA/12.9.1
export CUDA_HOME="$(dirname "$(dirname "$(which nvcc)")")"
export PATH="${CUDA_HOME}/bin:${PATH}"
export LD_LIBRARY_PATH="${CONDA_PREFIX}/lib:${CUDA_HOME}/lib64:${LD_LIBRARY_PATH:-}"
export HF_HOME=/gpfs/work2/0/prjs2013/users/qyao1/hf_cache
export HF_HUB_OFFLINE=1

mkdir -p slurm_logs vllm_logs
VLLM_LOG="vllm_logs/qwen35_s1_${SLURM_JOB_ID}.log"
echo "node=$(hostname)  vllm=$(which vllm)"

# Rebuild and re-export the frozen sanity prompts, then prove they did not drift.
python sanity/build_sanity_conditions.py > /dev/null
git diff --quiet sanity/sanity_conditions_manifest.json \
  || { echo "FATAL: sanity manifest changed - prompts are not the frozen ones" >&2; exit 1; }
python sanity/export_sanity_cli.py --input sanity/s1_qo_only.jsonl \
  --condition S1_QO_ONLY --out-dir sanity/cli/s1_qo_only --check

vllm serve "${MODEL}" --port "${PORT}" --tensor-parallel-size 1 \
  --max-model-len 65536 --reasoning-parser qwen3 --language-model-only \
  >| "${VLLM_LOG}" 2>&1 &
VP=$!
trap "kill ${VP} 2>/dev/null || true" EXIT
for _ in $(seq 1 180); do
  curl -sf "http://127.0.0.1:${PORT}/v1/models" >/dev/null && { echo "vLLM is up"; break; }
  kill -0 "${VP}" 2>/dev/null || { echo "FATAL: vLLM exited during startup" >&2
                                   tail -n 80 "${VLLM_LOG}" >&2; exit 1; }
  sleep 10
done
curl -sf "http://127.0.0.1:${PORT}/v1/models" >/dev/null \
  || { echo "FATAL: vLLM not ready" >&2; tail -n 80 "${VLLM_LOG}" >&2; exit 1; }

python qwen/run_qwen_paper50.py \
  --conditions "${COND}" --cli-dir "sanity/cli/%s" \
  --model "${MODEL}" --run-tag "${RUN_TAG}" \
  --base-url "http://127.0.0.1:${PORT}/v1" \
  --temperature 0.0 --top-p 1.0 --seed 20260823 --max-tokens 22000

echo "S1_QO_ONLY done"
